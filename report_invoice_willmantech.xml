<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_willmantech">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333; padding: 20px;">
                    
                    <div class="row" style="border-bottom: 2px solid #0055aa; padding-bottom: 15px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center;">
                        <div class="col-6" style="float: left; width: 50%;">
                            <h2 style="color: #0055aa; margin: 0; font-weight: 700;">WillmanTech S.L.</h2>
                            <p style="font-size: 12px; margin: 3px 0; color: #666;">Servicios Tecnológicos Avanzados</p>
                        </div>
                        <div class="col-6 text-right" style="float: right; width: 50%; text-align: right;">
                            <h4 style="margin: 0; color: #555; letter-spacing: 1px;">FACTURA</h4>
                            <p style="margin: 5px 0 0 0; font-weight: bold; font-size: 14px;">
                                Número: <span t-field="doc.name"/>
                            </p>
                            <p style="margin: 2px 0 0 0; color: #555; font-size: 13px;">
                                Fecha Emisión: <span t-field="doc.date" t-options='{"widget": "date"}'/>
                            </p>
                        </div>
                        <div style="clear: both;"></div>
                    </div>
                    
                    <div class="row" style="margin-bottom: 40px; background-color: #f8f9fa; padding: 15px; border-radius: 4px; border-left: 4px solid #0055aa;">
                        <div class="col-12">
                            <strong style="color: #0055aa; display: block; margin-bottom: 8px; font-size: 12px; letter-spacing: 0.5px;">CLIENTE</strong>
                            <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["name", "address", "phone", "email"], "no_marker": True}' style="line-height: 1.5; font-size: 13px;"/>
                        </div>
                    </div>
                    
                    <t t-set="has_discount" t-value="any(line.discount for line in doc.invoice_line_ids)"/>
                    
                    <table class="table table-sm" style="width: 100%; border-collapse: collapse; margin-bottom: 30px; font-size: 13px;">
                        <thead>
                            <tr style="background-color: #0055aa; color: white; text-align: left;">
                                <th style="padding: 10px; border: 1px solid #dee2e6; font-weight: 600;">Descripción</th>
                                <th style="padding: 10px; border: 1px solid #dee2e6; text-align: right; font-weight: 600; width: 10%;">Cantidad</th>
                                <th style="padding: 10px; border: 1px solid #dee2e6; text-align: right; font-weight: 600; width: 18%;">Precio Unitario</th>
                                <th t-if="has_discount" style="padding: 10px; border: 1px solid #dee2e6; text-align: right; font-weight: 600; width: 12%;">Desc. (%)</th>
                                <th style="padding: 10px; border: 1px solid #dee2e6; text-align: right; font-weight: 600; width: 18%;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.invoice_line_ids" t-as="line">
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 10px; border: 1px solid #dee2e6; color: #555;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; text-align: right;">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; text-align: right; white-space: nowrap;">
                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td t-if="has_discount" style="padding: 10px; border: 1px solid #dee2e6; text-align: right; color: #dc3545; font-weight: 500;">
                                        <span t-field="line.discount"/>%
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; text-align: right; font-weight: 600; white-space: nowrap;">
                                        <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <div class="row" style="margin-top: 20px; display: flex; justify-content: flex-end;">
                        <div class="col-6" style="width: 50%;"></div>
                        <div class="col-6" style="width: 50%; float: right;">
                            <table class="table table-sm" style="width: 100%; border-collapse: collapse; font-size: 13px;">
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 8px; font-weight: bold; color: #555;">Base Imponible:</td>
                                    <td style="padding: 8px; text-align: right; white-space: nowrap;">
                                        <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 8px; font-weight: bold; color: #555;">Impuestos:</td>
                                    <td style="padding: 8px; text-align: right; white-space: nowrap;">
                                        <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="background-color: #f8f9fa; border-top: 2px solid #0055aa;">
                                    <td style="padding: 10px; font-weight: bold; font-size: 15px; color: #0055aa;">TOTAL:</td>
                                    <td style="padding: 10px; text-align: right; font-weight: bold; font-size: 15px; color: #0055aa; white-space: nowrap;">
                                        <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="clear: both;"></div>
                    </div>
                    
                    <div style="margin-top: 60px; text-align: center; font-size: 10px; color: #777; border-top: 1px solid #eee; padding-top: 15px; line-height: 1.4;">
                        <strong>WillmanTech S.L.</strong> • CIF: B41XXXXXX • Inscrita en el Registro Mercantil de Sevilla.<br/>
                        Sistemas de Gestión Empresarial Avanzados.
                    </div>
                    
                </div>
            </t>
        </t>
    </template>
</odoo>