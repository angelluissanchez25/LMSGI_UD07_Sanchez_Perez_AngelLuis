<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_willmantech">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333;">
                    
                    <div class="row" style="border-bottom: 2px solid #0055aa; padding-bottom: 15px; margin-bottom: 30px;">
                        <div class="col-6">
                            <h2 style="color: #0055aa; margin: 0;">WillmanTech S.L.</h2>
                            <p style="font-size: 12px; margin: 3px 0;">Servicios Tecnológicos Avanzados</p>
                        </div>
                        <div class="col-6 text-right" style="text-align: right;">
                            <h4 style="margin: 0; color: #555;">FACTURA</h4>
                            <p style="margin: 5px 0 0 0; font-weight: bold;">
                                Número: <span t-field="doc.name"/>
                            </p>
                            <p style="margin: 2px 0 0 0;">
                                Fecha Emisión: <span t-field="doc.date" t-options='{"widget": "date"}'/>
                            </p>
                        </div>
                    </div>
                    
                    <div class="row" style="margin-bottom: 40px; background-color: #f8f9fa; padding: 15px; border-radius: 4px;">
                        <div class="col-12">
                            <strong style="color: #0055aa; display: block; margin-bottom: 5px;">CLIENTE:</strong>
                            <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["name", "address", "phone", "email"], "no_marker": True}'/>
                        </div>
                    </div>
                    
                    <t t-set="has_discount" t-value="any(line.discount for line in doc.invoice_line_ids)"/>
                    
                    <table class="table table-sm" style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
                        <thead>
                            <tr style="background-color: #0055aa; color: white; text-align: left;">
                                <th style="padding: 10px; border: 1px solid #dee2e6;">Descripción</th>
                                <th style="padding: 10px; border: 1px solid #dee2e6; text-align: right;">Cantidad</th>
                                <th style="padding: 10px; border: 1px solid #dee2e6; text-align: right;">Precio Unitario</th>
                                <th t-if="has_discount" style="padding: 10px; border: 1px solid #dee2e6; text-align: right;">Desc. (%)</th>
                                <th style="padding: 10px; border: 1px solid #dee2e6; text-align: right;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.invoice_line_ids" t-as="line">
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 10px; border: 1px solid #dee2e6;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; text-align: right;">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; text-align: right;">
                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td t-if="has_discount" style="padding: 10px; border: 1px solid #dee2e6; text-align: right; color: #dc3545;">
                                        <span t-field="line.discount"/>%
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #dee2e6; text-align: right; font-weight: bold;">
                                        <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <div class="row" style="margin-top: 20px;">
                        <div class="col-6"></div>
                        <div class="col-6" style="margin-left: auto; width: 40%;">
                            <table class="table table-sm" style="width: 100%; border-collapse: collapse;">
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 8px; font-weight: bold;">Base Imponible:</td>
                                    <td style="padding: 8px; text-align: right;">
                                        <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 8px; font-weight: bold;">Impuestos:</td>
                                    <td style="padding: 8px; text-align: right;">
                                        <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="background-color: #f8f9fa; border-top: 2px solid #0055aa;">
                                    <td style="padding: 10px; font-weight: bold; font-size: 16px; color: #0055aa;">TOTAL:</td>
                                    <td style="padding: 10px; text-align: right; font-weight: bold; font-size: 16px; color: #0055aa;">
                                        <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <div style="margin-top: 60px; text-align: center; font-size: 10px; color: #777; border-top: 1px solid #eee; padding-top: 10px;">
                        WillmanTech S.L. • CIF: B41XXXXXX • Inscrita en el Registro Mercantil de Sevilla.<br/>
                        Sistemas de Gestión Empresarial Avanzados.
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>